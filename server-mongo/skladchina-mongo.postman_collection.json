{
  "info": {
    "name": "Skladchina Mongo (лаб. 6)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "purchaseId",
      "value": ""
    },
    {
      "key": "participantId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Вход (admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@skladchina.local\",\n  \"password\": \"Admin123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.token) pm.collectionVariables.set(\"adminToken\", data.token);",
              "if (data.token) pm.collectionVariables.set(\"token\", data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Вход (user)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@skladchina.local\",\n  \"password\": \"User123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.token) pm.collectionVariables.set(\"token\", data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /purchases",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases"
          ]
        }
      }
    },
    {
      "name": "GET /purchases?search=кофе",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchases?search=кофе",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases"
          ],
          "query": [
            {
              "key": "search",
              "value": "кофе"
            }
          ]
        }
      }
    },
    {
      "name": "GET /purchases?tag=еда",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchases?tag=еда",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases"
          ],
          "query": [
            {
              "key": "tag",
              "value": "еда"
            }
          ]
        }
      }
    },
    {
      "name": "GET /purchases/:id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchases/{{purchaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases",
            "{{purchaseId}}"
          ]
        }
      }
    },
    {
      "name": "POST /purchases",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Набор книг по Node.js\",\n  \"organizer\": \"Игорь\",\n  \"targetAmount\": 8000,\n  \"deadline\": \"2026-12-31\",\n  \"tags\": [\n    \"книги\",\n    \"программирование\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.id) pm.collectionVariables.set(\"purchaseId\", data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /purchases (ошибка валидации)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ошибка\",\n  \"organizer\": \"Тест\",\n  \"targetAmount\": -5,\n  \"deadline\": \"2026-12-31\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT /purchases/:id",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchases/{{purchaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases",
            "{{purchaseId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Набор книг по Node.js (изм.)\",\n  \"organizer\": \"Игорь\",\n  \"targetAmount\": 9000,\n  \"deadline\": \"2027-01-10\",\n  \"status\": \"active\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST /purchases/:id/participants",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchases/{{purchaseId}}/participants",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases",
            "{{purchaseId}}",
            "participants"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Анна\",\n  \"contribution\": 1500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const last = data.participants && data.participants[data.participants.length - 1];",
              "if (last) pm.collectionVariables.set(\"participantId\", last.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH .../participants/:participantId/contribution",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/purchases/{{purchaseId}}/participants/{{participantId}}/contribution",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases",
            "{{purchaseId}}",
            "participants",
            "{{participantId}}",
            "contribution"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "DELETE .../participants/:participantId",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchases/{{purchaseId}}/participants/{{participantId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases",
            "{{purchaseId}}",
            "participants",
            "{{participantId}}"
          ]
        }
      }
    },
    {
      "name": "DELETE /purchases/:id",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/purchases/{{purchaseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "purchases",
            "{{purchaseId}}"
          ]
        }
      }
    }
  ]
}