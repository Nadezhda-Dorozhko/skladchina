<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — Складчина</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <a class="logo" href="/">Складчина</a>
    <nav>
      <a href="/">Главная</a>
      <a href="/add">Добавить складчину</a>
    </nav>
    <% if (user.isAuth) { %>
      <div class="header-account">
        <span class="user"><strong><%= user.name %></strong></span>
        <form method="POST" action="/logout">
          <button type="submit" class="logout">Выйти</button>
        </form>
      </div>
    <% } else { %>
      <div class="header-account">
        <a class="auth-link" href="/login">Войти</a>
      </div>
    <% } %>
  </header>
