<%- include('partials/header', { title: 'Новая складчина' }) %>
<h1>Добавление складчины</h1>

<% if (Object.keys(errors).length > 0) { %>
  <div class="errors">
    <p>Форма не отправлена. Исправьте ошибки:</p>
    <ul>
      <% Object.values(errors).forEach(function (msg) { %>
        <li><%= msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form method="POST" action="/add" novalidate>
  <div class="form-grid">
    <label class="wide">Название (до <%= limits.title.max %> символов)
      <input type="text" name="title" value="<%= form.title %>" minlength="<%= limits.title.min %>" maxlength="<%= limits.title.max %>">
    </label>
    <label>Организатор (до <%= limits.organizer.max %> символов)
      <input type="text" name="organizer" value="<%= form.organizer %>" minlength="<%= limits.organizer.min %>" maxlength="<%= limits.organizer.max %>">
    </label>
    <label>Срок завершения
      <input type="date" name="deadline" value="<%= form.deadline %>" max="9999-12-31">
    </label>
    <label class="wide">Описание (до <%= limits.description.max %> символов, необязательно)
      <textarea name="description" rows="2" maxlength="<%= limits.description.max %>"><%= form.description %></textarea>
    </label>
    <label>Целевая сумма
      <input type="number" name="targetAmount" value="<%= form.targetAmount %>" min="<%= limits.targetAmount.min %>" max="<%= limits.targetAmount.max %>" step="any">
    </label>
    <label>Собранная сумма
      <input type="number" name="currentAmount" value="<%= form.currentAmount %>" min="<%= limits.currentAmount.min %>" max="<%= limits.currentAmount.max %>" step="any">
    </label>
    <label>Количество участников
      <input type="number" name="participantsCount" value="<%= form.participantsCount %>" min="<%= limits.participantsCount.min %>" max="<%= limits.participantsCount.max %>" step="1">
    </label>
    <label>Статус
      <select name="status">
        <option value="active" <%= form.status !== 'completed' ? 'selected' : '' %>>Активна</option>
        <option value="completed" <%= form.status === 'completed' ? 'selected' : '' %>>Завершена</option>
      </select>
    </label>
  </div>
  <button type="submit" class="btn">Добавить</button>
</form>
<%- include('partials/footer') %>
